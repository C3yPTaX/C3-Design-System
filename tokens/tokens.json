{
  "$description": "C3yPTaX Design Tokens. Einzige Quelle aller Designwerte. Format: W3C Design Tokens (DTCG). Nach Änderungen scripts/build-tokens.py ausführen.",
  "color": {
    "$type": "color",
    "brand": {
      "$description": "Gemessene Markenfarben aus den Logos. Nur für Logo, Splash und Marketing, nicht für normale Bedienelemente.",
      "cyan": { "$value": "#07FCFD", "$description": "Leuchtendes Cyan der Logo-Konturen" },
      "teal": { "$value": "#06D0C4", "$description": "Türkis der Schaltkreislinien" },
      "green": { "$value": "#48F762", "$description": "Grüner Kern im Zentrum des Logos" },
      "ice": { "$value": "#D5FDFE", "$description": "Helle Lichtkante der Buchstaben" },
      "deep": { "$value": "#01070C", "$description": "Hintergrund der Originalgrafiken" },
      "glow": { "$value": "#063B3D", "$description": "Dunkles Türkis im Lichthof" }
    },
    "bg": {
      "canvas": { "$value": "#0A0D10", "$description": "Haupthintergrund des Fensters" },
      "subtle": { "$value": "#0E1215", "$description": "Nebenhintergrund: Seitenleiste, Titelleiste, Statusleiste" },
      "overlay": { "$value": "#030507B8", "$description": "Abdunklung hinter Dialogen" }
    },
    "surface": {
      "card": { "$value": "#14181D", "$description": "Karten, Panels, Dialoge" },
      "input": { "$value": "#1A1F25", "$description": "Eingabefelder, Dropdowns, Listenzeilen beim Hover" },
      "popover": { "$value": "#1C2127", "$description": "Menüs, Dropdown-Listen, Tooltips" },
      "control": { "$value": "#20262D", "$description": "Sekundäre Buttons" },
      "controlHover": { "$value": "#29303A" },
      "controlPressed": { "$value": "#1C2128" },
      "disabled": { "$value": "#171B20" }
    },
    "border": {
      "subtle": { "$value": "#232A31", "$description": "Trennlinien, Tabellenzeilen" },
      "default": { "$value": "#2E363F", "$description": "Rahmen von Karten und Dialogen" },
      "strong": { "$value": "#3D4752", "$description": "Rahmen von Menüs, Hover auf Karten" },
      "control": { "$value": "#4B5661", "$description": "Rahmen von Eingabefeldern und Checkboxen" },
      "focus": { "$value": "{color.accent.hover}", "$description": "Fokusring, 2 px" }
    },
    "text": {
      "primary": { "$value": "#E6EBEF", "$description": "Überschriften und Fließtext" },
      "secondary": { "$value": "#A8B2BC", "$description": "Beschriftungen, Tabellenwerte zweiter Ordnung" },
      "muted": { "$value": "#8A949E", "$description": "Hilfetexte, Zeitstempel, Platzhalter" },
      "disabled": { "$value": "#5E6670" },
      "onAccent": { "$value": "#04181A", "$description": "Text auf Cyan-Flächen" },
      "link": { "$value": "{color.accent.hover}" }
    },
    "accent": {
      "$description": "Primäre Akzentfarbe Cyan. Für Hauptaktion, Fokus, Auswahl und aktive Navigation.",
      "default": { "$value": "#19D4DC" },
      "hover": { "$value": "#4DE2E8" },
      "pressed": { "$value": "#12B3BA" },
      "text": { "$value": "#5FE6EC", "$description": "Akzentfarbe für Text auf dunklen Flächen" },
      "subtle": { "$value": "#0E2A2E", "$description": "Hintergrund ausgewählter Zeilen und aktiver Navigation" },
      "subtleHover": { "$value": "#12363B" },
      "border": { "$value": "#1D6A70" }
    },
    "secondary": {
      "$description": "Sekundärer Akzent Türkis. Zweite Datenreihe, ergänzende Hervorhebung.",
      "default": { "$value": "#1FC7B6" },
      "subtle": { "$value": "#0D2A27" }
    },
    "status": {
      "success": { "$value": "#3FD97A" },
      "successSubtle": { "$value": "#0F2A1A" },
      "successBorder": { "$value": "#1F5C36" },
      "warning": { "$value": "#F5A524" },
      "warningSubtle": { "$value": "#2E220C" },
      "warningBorder": { "$value": "#6B4A12" },
      "danger": { "$value": "#FF6B70", "$description": "Fehlertext und Fehlersymbole" },
      "dangerSolid": { "$value": "#C8373E", "$description": "Fläche destruktiver Buttons, weißer Text" },
      "dangerSolidHover": { "$value": "#B02E35", "$description": "Hover dunkelt ab, damit weißer Text lesbar bleibt" },
      "dangerSubtle": { "$value": "#2E1316" },
      "dangerBorder": { "$value": "#6E2A2E" },
      "info": { "$value": "{color.accent.default}" },
      "infoSubtle": { "$value": "{color.accent.subtle}" },
      "infoBorder": { "$value": "{color.accent.border}" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "ui": { "$value": ["Segoe UI Variable Text", "Segoe UI", "-apple-system", "BlinkMacSystemFont", "Inter", "Helvetica Neue", "Arial", "sans-serif"] },
      "mono": { "$value": ["Cascadia Mono", "Consolas", "SF Mono", "JetBrains Mono", "Menlo", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "semibold": { "$value": 600 }
    },
    "size": {
      "$type": "dimension",
      "$description": "Pixel bei 96 dpi. WinForms: Punkt = Pixel x 0,75.",
      "xs": { "$value": "12px" },
      "sm": { "$value": "13px" },
      "md": { "$value": "14px" },
      "lg": { "$value": "16px" },
      "xl": { "$value": "20px" },
      "2xl": { "$value": "24px" },
      "3xl": { "$value": "28px" }
    },
    "lineHeight": {
      "$type": "number",
      "tight": { "$value": 1.25 },
      "normal": { "$value": 1.45 }
    }
  },
  "typography": {
    "$type": "typography",
    "display": { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "{font.size.3xl}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.lineHeight.tight}" }, "$description": "Selten. Startseite, leere Zustände." },
    "title": { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "{font.size.xl}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.lineHeight.tight}" }, "$description": "Seitentitel" },
    "heading": { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "{font.size.lg}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.lineHeight.tight}" }, "$description": "Karten- und Dialogtitel" },
    "label": { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "{font.size.sm}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.lineHeight.tight}" }, "$description": "Feldbeschriftungen, Buttons, Tabs" },
    "body": { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "{font.size.md}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.lineHeight.normal}" }, "$description": "Fließtext, Tabellen" },
    "small": { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "{font.size.sm}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.lineHeight.normal}" }, "$description": "Hilfetexte, Metadaten" },
    "caption": { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "{font.size.xs}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.lineHeight.normal}" }, "$description": "Zeitstempel, Badges, Statusleiste" },
    "code": { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "{font.size.sm}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.lineHeight.normal}" }, "$description": "Pfade, Werte, Logs" }
  },
  "space": {
    "$type": "dimension",
    "$description": "4-Pixel-Raster",
    "0": { "$value": "0px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" }
  },
  "radius": {
    "$type": "dimension",
    "xs": { "$value": "4px", "$description": "Checkbox, Badge, Tooltip" },
    "sm": { "$value": "6px", "$description": "Buttons, Eingabefelder, Listenzeilen" },
    "md": { "$value": "8px", "$description": "Menüs, Toasts" },
    "lg": { "$value": "10px", "$description": "Karten, Panels" },
    "xl": { "$value": "14px", "$description": "Dialoge" },
    "full": { "$value": "9999px", "$description": "Schalter, Statuspunkte" }
  },
  "size": {
    "$type": "dimension",
    "control": {
      "sm": { "$value": "28px" },
      "md": { "$value": "32px", "$description": "Standardhöhe für Buttons und Eingabefelder" },
      "lg": { "$value": "40px" }
    },
    "icon": {
      "sm": { "$value": "16px" },
      "md": { "$value": "20px" }
    },
    "row": {
      "compact": { "$value": "32px" },
      "default": { "$value": "40px" }
    },
    "sidebar": { "$value": "232px" },
    "titlebar": { "$value": "44px" },
    "focusRing": { "$value": "2px" }
  },
  "shadow": {
    "$type": "shadow",
    "sm": { "$value": { "color": "#00000066", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }, "$description": "Hover auf Karten" },
    "md": { "$value": { "color": "#00000073", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px" }, "$description": "Menüs, Toasts" },
    "lg": { "$value": { "color": "#0000008C", "offsetX": "0px", "offsetY": "24px", "blur": "64px", "spread": "0px" }, "$description": "Dialoge" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "80ms", "$description": "Drücken, Farbwechsel bei Klick" },
      "fast": { "$value": "120ms", "$description": "Hover, Fokus, Checkbox" },
      "normal": { "$value": "180ms", "$description": "Tabs, Dropdowns, Statuswechsel" },
      "slow": { "$value": "250ms", "$description": "Dialoge, aufklappende Bereiche, Toasts" },
      "loop": { "$value": "1400ms", "$description": "Unbestimmter Fortschritt und Skeleton, ein Durchlauf" },
      "spin": { "$value": "900ms", "$description": "Eine Umdrehung des Ladekreises" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1], "$description": "Zustandswechsel auf der Stelle" },
      "enter": { "$value": [0.16, 1, 0.3, 1], "$description": "Erscheinen: schneller Start, weiches Abbremsen" },
      "exit": { "$value": [0.4, 0, 1, 1], "$description": "Verschwinden: kurz und unauffällig" },
      "linear": { "$value": [0, 0, 1, 1], "$description": "Nur für Fortschritt und Drehung" }
    },
    "distance": {
      "$type": "dimension",
      "lift": { "$value": "2px", "$description": "Anheben von Karten beim Hover" },
      "shift": { "$value": "4px", "$description": "Dropdowns, Toasts beim Erscheinen" },
      "enter": { "$value": "8px", "$description": "Größte erlaubte Bewegung" }
    },
    "scale": {
      "$type": "number",
      "press": { "$value": 0.98, "$description": "Button beim Drücken" },
      "enter": { "$value": 0.97, "$description": "Startgröße von Dialogen" }
    }
  }
}
